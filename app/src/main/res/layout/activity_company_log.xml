<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:background="#F4F6F9">

    <!-- Header Container with fitsSystemWindows="true" for seamless status bar color -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D2E5C"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnLogBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Company Log &amp; Usage Analytics"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnLogCalendar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_my_calendar"
                app:tint="#FFFFFF"
                android:contentDescription="Select Date Range"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Tab Switcher: Usage Analytics vs License Management -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0D2E5C"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnTabUsage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:text="📊 Usage Analytics"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnTabLicense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_weight="1"
            android:text="📜 License Management"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Company Filter Row -->
    <LinearLayout
        android:id="@+id/layoutFilterRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical"
        android:elevation="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Company:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0D2E5C"
            android:layout_marginEnd="12dp"/>

        <Spinner
            android:id="@+id/spinnerCompanyFilter"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@android:drawable/spinner_background"/>
    </LinearLayout>

    <!-- Date Range & Filter Chips -->
    <LinearLayout
        android:id="@+id/layoutDateChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:elevation="2dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvLogRangeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0D2E5C"
            android:layout_marginBottom="6dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Summary Stats Cards -->
    <LinearLayout
        android:id="@+id/layoutStatsCards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginEnd="6dp"
            android:elevation="1dp">
            <TextView
                android:id="@+id/tvStat1Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Users"
                android:textSize="11sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvStatUsers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0D2E5C"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:elevation="1dp">
            <TextView
                android:id="@+id/tvStat2Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Actions"
                android:textSize="11sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvStatActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginStart="6dp"
            android:elevation="1dp">
            <TextView
                android:id="@+id/tvStat3Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Company"
                android:textSize="11sp"
                android:textColor="#757575"/>
            <TextView
                android:id="@+id/tvStatTopCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#C62828"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scoreboard / Run-Rate Style Graph Container -->
    <LinearLayout
        android:id="@+id/layoutScoreboardGraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp"
        android:elevation="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Scoreboard Run-Rate (Company Activity Comparison)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0D2E5C"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:id="@+id/scoreboardGraphContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="  Usage Ranking &amp; Logs (Admins, Managers &amp; Supervisors)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#555555"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"/>

    <TextView
        android:id="@+id/tvLogEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No activity logs found for this date range."
        android:textColor="#888888"
        android:textSize="14sp"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCompanyLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"/>

</LinearLayout>
